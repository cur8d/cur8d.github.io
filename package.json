    "framer-motion": "13.3.0",
    "lucide-react": "1.46.0",
    "next": "16.3.5",
    "next-themes": "0.4.6",
    "postcss": "^8.5.28",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-icons": "^5.7.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
